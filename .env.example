# Copy this file to ".env" and fill in your Supabase project values.
# Both are safe to expose to the browser — access is gated by Row-Level Security.
# Find them in the Supabase dashboard: Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack (test mode) — PUBLIC key only on the client. The SECRET key must
# live server-side (Supabase Edge Function secret), never in this file.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx
